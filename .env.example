# Copy to .env and fill in real values before starting

# ── Panel ────────────────────────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_long_random_string
CONTAINER_API_TOKEN=change_this_shared_secret

# ── MySQL ────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=changeme_mysql_root
MYSQL_PASSWORD=changeme_mysql

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme_redis

# ── PowerDNS ─────────────────────────────────────────────────────────────────
PDNS_API_KEY=changeme_pdns_key

# ── Mail ─────────────────────────────────────────────────────────────────────
MAIL_HOSTNAME=mail.example.com
ALLOWED_SENDER_DOMAINS=example.com

# ── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme_grafana

# ── Let's Encrypt ─────────────────────────────────────────────────────────────
ACME_EMAIL=admin@example.com

# ── Timezone ─────────────────────────────────────────────────────────────────
TZ=UTC

# ── Session & Security ───────────────────────────────────────────────────────
SESSION_IDLE_MINUTES=60               # Session idle timeout (default: 60 min)
MFA_REQUIRED_ROLES=admin,superadmin   # Roles that require MFA (comma-separated)
PASSWORD_MIN_LENGTH=12                # Minimum password length requirement
PASSWORD_HISTORY=5                    # Number of previous passwords to check
LOGIN_RATE_LIMIT=5                    # Failed login attempts before lockout
LOGIN_LOCKOUT_MINUTES=15              # Lockout duration after rate limit hit
REGISTER_RATE_LIMIT=5                 # Registrations per hour per IP

# ── Data Retention ───────────────────────────────────────────────────────────
RETENTION_REQUEST_LOGS_DAYS=365       # How long to keep API request logs
RETENTION_CONSENT_DAYS=1095           # How long to keep consent records (3 yrs)
RETENTION_DSAR_COMPLETED_DAYS=365     # How long to keep completed DSARs
RETENTION_SUSPENDED_ACCOUNT_DAYS=90   # Grace period before purging suspended accounts

# ── Breach Notification ──────────────────────────────────────────────────────
BREACH_NOTIFICATION_EMAIL=dpo@example.com    # DPA notification contact
BREACH_NOTIFICATION_HOURS=72                 # GDPR: notify DPA within 72 hours
BREACH_NOTIFICATION_AFFECTED_HOURS=96        # Notify affected users within 96 hours
